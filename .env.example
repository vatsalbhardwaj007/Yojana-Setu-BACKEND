# Application Configuration
APP_NAME="YojanaSetu Backend"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database / Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
DATABASE_URL="postgresql://postgres:password@localhost:5432/yojanasetu"

# Authentication / Supabase JWT Configuration
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-placeholder"
JWT_ALGORITHM="HS256"
JWT_AUDIENCE="authenticated"


# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# WhatsApp Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-app-secret
GRAPH_API_VERSION=v23.0

# M2 Backend Integration
M2_BACKEND_URL=http://localhost:8000
M2_API_KEY=
M2_TIMEOUT=10
